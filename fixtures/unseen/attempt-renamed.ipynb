      "source": [
        "import matplotlib.pyplot as plt\n",
        "scores = [1, 4, 8, 13, 17, 19, 23, 26, 31, 34, 38, 40]\n",
        "fig, ax = plt.subplots()"
      ]
    },
    {
      "cell_type": "code",
      "id": "plot1",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "ax.hist(scores, bins=[0,10,20,30,40], density=False)\n",
