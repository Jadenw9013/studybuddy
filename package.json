{
  "name": "live-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:fixture": "node scripts/dev.mjs --fixture",
    "seed:demo": "node scripts/seed.mjs",
    "seed:dsa": "node scripts/seed-dsa.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "eval:offline": "node scripts/offline.mjs",
    "eval:live": "node evals/live/preflight.mjs",
    "eval:tutor:browser": "playwright test --config playwright.tutor-live.config.ts",
    "eval:voice:browser": "playwright test --config evals/live/voice.playwright.config.ts",
    "build": "node scripts/build-web.mjs",
    "api": "tsx apps/api/src/index.ts",
    "web": "next dev apps/web -p 3000",
    "verify:handoff": "python scripts/verify-handoff.py",
    "db:migrate": "node scripts/migrate.mjs",
    "test:voice": "tsx --test evals/live/relay.test.ts evals/live/client.test.ts",
    "test:worker": "node scripts/test-worker.mjs",
    "test:companion": "pnpm --dir extensions/jupyterlab test",
    "test:voice:metrics": "node --test evals/live/summarize.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "node supabase/tests/run.mjs",
    "test:services": "node --import tsx evals/db/service.ts",
    "eval:numeric": "tsx evals/numeric-probe.ts",
    "eval:illustration": "tsx evals/illustration-live.ts",
    "eval:illustration:browser": "playwright test --config playwright.illustration-live.config.ts",
    "test:illustration:services": "node --import tsx evals/db/illustration-service.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/websocket": "11.3.7",
    "@google/genai": "3.3.0",
    "@supabase/supabase-js": "2.119.0",
    "ajv": "8.20.0",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "katex": "0.19.1",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "stripe": "23.1.0",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "prettier": "3.10.1",
    "supabase": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
