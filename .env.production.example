# Production template only. Copy to a PRIVATE .env.production on the API host.
# Do not import this entire file into the Vercel frontend. See production-hosting.md.
# Provider calls and billing remain disabled until their production gates are reviewed.

APP_MODE=live
NODE_ENV=production
DEV_AUTH_BYPASS=false
WEB_ORIGIN=https://studybuddy.example.com
API_PUBLIC_ORIGIN=https://api.studybuddy.example.com
API_HOST=0.0.0.0
API_PORT=3001
DATA_DIR=/var/lib/studybuddy

# Vercel FRONTEND setting: the public HTTPS API URL, not localhost.
# The Compose worker overrides this with its private container-network URL.
API_INTERNAL_ORIGIN=https://api.studybuddy.example.com

# Hosted Supabase, not the development stack on your laptop.
# Copy the TLS-enabled connection string supplied by the hosted database.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-hosted-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-hosted-server-only-service-key
DATABASE_URL=replace-with-hosted-postgres-connection-string-with-tls

# Generate DIFFERENT random secrets of at least 32 characters.
# INTERNAL_WORKER_SECRET must match between the API and worker.
WS_TICKET_SECRET=replace-with-a-new-cryptographically-random-ticket-secret
INTERNAL_WORKER_SECRET=replace-with-a-different-cryptographically-random-worker-secret

# Keep private model credentials on the API host only.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
PAID_CALLS_ENABLED=false
ENABLE_LIVE=false
SPEND_CEILING_USD=7.60
SESSION_MAX_SECONDS=1200
TEXT_DAILY_LIMIT=50
# Set reviewed, versioned rates and finite modality limits before enabling calls.
# A local development allowance is not a production allowance or an invoice.
MODEL_UNIT_PRICES_JSON=
MODEL_UNIT_LIMITS_JSON=

# Optional illustration provider: still disabled, with no assumed price.
ENABLE_ILLUSTRATIONS=false
ILLUSTRATION_PROVIDER=bfl
ILLUSTRATION_MODEL=flux-2-klein-9b
BFL_BASE_URL=https://api.bfl.ai
BFL_API_KEY=
ILLUSTRATION_REQUEST_COST_USD=0
ILLUSTRATION_PRICE_VERSION=
ILLUSTRATION_DAILY_LIMIT=10

# Optional features are enabled separately after their production checks.
ENABLE_COMPANION=false
# Keep false with these images: optional embeddings need additional API/worker setup.
ENABLE_HYBRID=false
BGE_CACHE_DIR=/var/cache/studybuddy-models
RECORD_AUDIO=false
RECORD_SCREEN=false
ENABLE_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
