FROM node:22.16.0-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY packages packages
ARG API_INTERNAL_ORIGIN=http://api:3001
ENV API_INTERNAL_ORIGIN=$API_INTERNAL_ORIGIN
RUN node -e "require('fs').copyFileSync(require.resolve('pdfjs-dist/build/pdf.worker.min.mjs'),'apps/web/public/pdf.worker.min.mjs')"
RUN pnpm build
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node","node_modules/next/dist/bin/next","start","apps/web","-p","3000","-H","0.0.0.0"]
