# Fill the matching private .env file. Never put real credentials in this template.

# 1. GEMINI — implemented: typed tutoring + real-time voice/screen understanding
# One Google Gemini Developer API key serves both configured models.
# Account access and live acceptance must be verified; see SETUP.md.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
ENABLE_LIVE=false
PAID_CALLS_ENABLED=false

# 2. FLUX.2 KLEIN — implemented optional illustrations, disabled by default
# Add a funded Black Forest Labs key: https://dashboard.bfl.ai
# Requires APP_MODE=live, ENABLE_ILLUSTRATIONS=true and PAID_CALLS_ENABLED=true.
# Each Generate action requests one 768x768 conceptual illustration; no references.
ENABLE_ILLUSTRATIONS=false
ILLUSTRATION_PROVIDER=bfl
ILLUSTRATION_MODEL=flux-2-klein-9b
# API evaluation baseline: 9B. Compare FLUX 3 Image Klein before a release choice.
# 4B remains an option for smaller self-hosted deployments; no automatic fallback.
BFL_BASE_URL=https://api.bfl.ai
BFL_API_KEY=
# Versioned estimate for the fixed klein9B request; actual invoice remains separate.
ILLUSTRATION_REQUEST_COST_USD=0.015
ILLUSTRATION_PRICE_VERSION=bfl-public-2026-11-19-768px
ILLUSTRATION_DAILY_LIMIT=10
# Charts, equations and numeric labels use computed Vega-Lite/KaTeX/SVG.

# 3. SUPABASE — implemented: sign-in, private files, Postgres + retrieval
# Project Settings: project URL + publishable (or legacy anon) key.
# SUPABASE_SERVICE_ROLE_KEY is the server-only service-role/secret key.
# DATABASE_URL is the private server connection string, including DB password.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted sign-in email: configure your SMTP provider inside Supabase Auth settings.
# This app does not read a Resend/SendGrid/SMTP API key directly.

# 4. STRIPE — optional billing integration; use test mode during development
# Secret API key, webhook signing secret, approved one-time $19 Price ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ENABLE_BILLING=false

# 5. LOCAL TOOLS — implemented; no additional paid API keys required
# BGE-small-en-v1.5 embeddings run locally with revision-pinned weights.
# Install the embeddings extra and explicitly prepare weights before enabling.
ENABLE_HYBRID=false
BGE_CACHE_DIR=.data/model-cache
# On macOS/Linux use .venv/bin/python instead.
PYTHON_PATH=.venv/Scripts/python.exe
# JupyterLab pairs with a short-lived URL and local Apply, not a shared API key.
ENABLE_COMPANION=true
# Vega-Lite, KaTeX, SVG, PDF.js, pypdf, CSV, nbformat and Playwright need no API key.
# OpenAI, Anthropic, LiveKit and hosted-browser alternatives are not integrated.

# 6. COST CONTROLS — required before paid Gemini calls can be admitted
SPEND_CEILING_USD=7.60
SESSION_MAX_SECONDS=1200
TEXT_DAILY_LIMIT=50
# Reviewed USD per million token rates: {"version":"review-date","currency":"USD","models":{"MODEL":{"input":{"TEXT":rate,"AUDIO":rate,"IMAGE":rate},"output":{"TEXT":rate,"AUDIO":rate,"IMAGE":rate},"cachedInput":{"TEXT":rate,"AUDIO":rate,"IMAGE":rate}}}}
MODEL_UNIT_PRICES_JSON=
# Per-call aggregate ceilings for each enabled modality, matched to provider context/output/media bounds.
# {"text":{"input":{"TEXT":count,"AUDIO":0,"IMAGE":0},"output":{"TEXT":count,"AUDIO":0,"IMAGE":0},"cachedInput":{"TEXT":0,"AUDIO":0,"IMAGE":0}},"live":{...}}
MODEL_UNIT_LIMITS_JSON=

# 7. APP RUNTIME + INTERNAL SECRETS
# Fixture mode is local-only. Use APP_MODE=live for actual Supabase/Gemini services.
# pnpm dev:fixture always forces fixture mode; adding keys alone does not enable it.
APP_MODE=fixture
NODE_ENV=development
# Optional local testing only. Skips sign-in into one test workspace; rejected in production.
# Google sign-in is planned for a later iteration.
DEV_AUTH_BYPASS=false
# Existing local invited profile UUID; no password or emailed code is needed in bypass mode.
DEV_AUTH_USER_ID=
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_ORIGIN=http://127.0.0.1:3001
WS_TICKET_SECRET=replace-with-at-least-32-random-characters
INTERNAL_WORKER_SECRET=local-worker-development-secret
# Generate separate random 32+ character secrets before an operated deployment.
RECORD_AUDIO=false
RECORD_SCREEN=false
